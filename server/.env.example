# Database Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT Auth Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=7d
COOKIE_EXPIRES=7

# Frontend Production URL (used for CORS and OAuth redirect callbacks)
FRONTEND_URL=https://your-app-name.vercel.app

# Zernio API Key for Multi-Platform Social Media Sync & Publishing
ZERNIO_API_KEY=sk_your_zernio_api_key_here
ZERNIO_REDIRECT_URI=https://your-app-name.vercel.app/accounts?connected=1

# Gemini AI API Key for Post Generator
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Cron Secret (if Vercel Cron Job is enabled for automated post scheduler)
CRON_SECRET=your_cron_secret_key
