{
  "buildCommand": "cd server && npm install && npm run build && cd ../Client && npm install && npm run build",
  "outputDirectory": "Client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/publish-due",
      "schedule": "0 0 * * *"
    }
  ]
}
